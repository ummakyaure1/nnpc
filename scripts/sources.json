          "https://www.nuprc.gov.ng/"
        ],
        "article_url_pattern": "/media/news/",
        "verify": false
      },
      {
        "name": "NNPC Ltd",
        "regulator": "NNPC",
        "start_urls": [
          "https://nnpcgroup.com/"
