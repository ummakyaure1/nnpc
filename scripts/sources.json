  "nosdra": {
    "api_url": "https://nosdra.oilspillmonitor.ng/osm-2019/api/spill-data.php?dataset=nosdra&format=json",
    "public_page": "https://nosdra.oilspillmonitor.ng/oilspillmonitor.html",
    "volume_unit": "bbl",
    "_volume_unit_note": "Confirm on the Oil Spill Monitor that 'estimated quantity' is in barrels; the value as reported is always kept too.",
    "lookback_days": 60,
    "start_urls": [
      "https://nosdra.oilspillmonitor.ng/oilspillmonitor.html"
    ],
    "data_file_extensions": [
      "csv",
      "xlsx",
      "xls",
      "json",
      "pdf"
    ],
    "keywords": [
      "spill",
      "incident",
      "jiv",
      "query",
      "feature",
      "data",
      "download",
      "export"
    ],
    "exclude_words": [
      "guide",
      "training",
      "manual",
      "brochure"
    ],
    "max_files_per_run": 8
  },
  "assets": {
    "scope": "all",
    "reports_index": "https://www.nuprc.gov.ng/reports",
    "report_keywords": [
      "acreage",
      "concession",
      "licen",
      "lease"
    ],
    "max_reports_per_series": 1,
    "_scope_note": "'all' covers every title in the NUPRC concession report and every outline on the map; 'pilots' limits to the 11 pilot blocks."
  },
  "reference": {
    "folder": "data/reference",
    "title_properties": [
      "title",
      "TITLE",
      "title_number",
      "OML",
      "BLOCK",
      "Block",
      "NAME",
      "Name",
      "name"
    ],
    "alias_scope": "all",
    "_note": "Boundaries follow assets.scope (pilots by default; set to 'all' for every block). Aliases go in for every block (alias_scope 'all') so news about any block can be tagged."
  },
  "nmdpra": {
    "_note": "stage=true sends the newest documents to the MD bulletin; stage=false only lists them in the log.",
